{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rose-aili.local/pptx/readiness-report.schema.json",
  "title": "PPTX workspace or delivery readiness report",
  "type": "object",
  "required": ["schema_version", "report_kind", "status", "blockers", "unverified", "next_action"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "report_kind": {"enum": ["workspace-readiness", "delivery-readiness"]},
    "status": {"enum": ["ready", "needs_attention", "blocked"]},
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message", "severity", "next_action"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1},
          "severity": {"enum": ["hard", "attention"]},
          "next_action": {"type": "string", "minLength": 1},
          "path": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "unverified": {"type": "array", "items": {"type": "object"}},
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reason"],
      "properties": {"type": {"type": "string"}, "reason": {"type": "string"}}
    }
  }
}
