{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rose-aili.local/pptx/style-lock.schema.json",
  "title": "Reviewed current style proof lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_fingerprint", "outline_sha256", "renderer_source_sha256", "design_contract_sha256", "proof_build_report_sha256", "proof_pptx_sha256", "proof_render_sha256", "review_sha256", "slide_ids", "disposition"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_fingerprint": {"$ref": "#/$defs/hash"},
    "outline_sha256": {"$ref": "#/$defs/hash"},
    "renderer_source_sha256": {"$ref": "#/$defs/hash"},
    "design_contract_sha256": {"$ref": "#/$defs/hash"},
    "proof_build_report_sha256": {"$ref": "#/$defs/hash"},
    "proof_pptx_sha256": {"$ref": "#/$defs/hash"},
    "proof_render_sha256": {"$ref": "#/$defs/hash"},
    "review_sha256": {"$ref": "#/$defs/hash"},
    "slide_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "disposition": {"enum": ["locked", "need-user", "blocked"]}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
