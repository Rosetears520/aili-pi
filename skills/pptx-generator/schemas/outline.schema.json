{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rose-aili.local/pptx/outline.schema.json",
  "title": "Generated deterministic PPTX outline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generator_version", "source_plan_path", "source_plan_sha256", "deck", "slides", "diagnostics"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generator_version": {"type": "string", "minLength": 1},
    "source_plan_path": {"type": "string", "minLength": 1},
    "source_plan_sha256": {"$ref": "#/$defs/hash"},
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_title", "topic", "declared_slide_count", "expected_duration", "overall_logic"],
      "properties": {
        "plan_title": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "declared_slide_count": {"type": "integer", "minimum": 1},
        "expected_duration": {"type": "string", "minLength": 1},
        "overall_logic": {"type": "string", "minLength": 1}
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ordinal", "title", "layout", "content", "sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
          "ordinal": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "minLength": 1},
          "layout": {"type": "string"},
          "content": {"type": "string"},
          "sha256": {"$ref": "#/$defs/hash"},
          "hints": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "role": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
              "variant": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
            }
          }
        }
      }
    },
    "diagnostics": {"type": "array", "maxItems": 0}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
