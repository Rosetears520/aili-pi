{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rose-aili.local/pptx/render-manifest.schema.json",
  "title": "Current rendered-slide evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_kind", "status", "pptx_path", "pptx_sha256", "render_sha256", "slide_ids", "artifacts", "contact_sheet", "issue_scan", "officecli", "visual_review_passed", "host_image_inspection_required", "watch_used_as_proof"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "report_kind": {"const": "render-manifest"},
    "status": {"const": "rendered-awaiting-visual-review"},
    "pptx_path": {"type": "string", "minLength": 1},
    "pptx_sha256": {"$ref": "#/$defs/hash"},
    "render_sha256": {"$ref": "#/$defs/hash"},
    "slide_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slideFile"}},
    "contact_sheet": {"$ref": "#/$defs/file"},
    "issue_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "pptx_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "pptx_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "officecli": {"type": "object"},
    "visual_review_passed": {"type": "boolean"},
    "host_image_inspection_required": {"const": true},
    "watch_used_as_proof": {"const": false}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "size": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "slideFile": {
      "type": "object",
      "required": ["slide_id", "path", "sha256"],
      "properties": {
        "slide_id": {"type": "string", "minLength": 1},
        "page_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "size": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
