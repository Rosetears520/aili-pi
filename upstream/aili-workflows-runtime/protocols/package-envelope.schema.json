        "review_or_security_disposition": {
          "type": "string"
        },
        "freshness": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "linked",
            "missing",
            "stale",
            "conflicting",
            "blocked",
            "Unverified"
          ]
        }
      },
      "additionalProperties": false
    }
